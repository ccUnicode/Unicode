---
/**
 * admin.astro
 * Administration panel to view application candidates.
 * - Directors sign in with a one-time code sent to their email and see every area, starting on their own;
 *   GTH also opens the call's management panel. The shared password stays as a fallback.
 * - Dashboard with filters by area, option type, and sorting.
 * - Export to Excel (CSV).
 */
import Layout from "../layouts/Layout.astro";
import AdminSelect from "../components/admin/AdminSelect.astro";
---

<Layout title="Postulaciones · Administración">
  <div id="admin-page">
  <div
    id="login-screen"
    class="min-h-dvh flex items-center justify-center px-4 py-6"
  >
    <div
      class="w-full max-w-sm bg-zinc-900/80 border border-zinc-800 rounded-2xl p-5 sm:p-8"
    >
      <h2 class="text-white text-xl font-bold text-center">Acceso de directores</h2>
      <p id="login-intro" class="text-zinc-400 text-[14px] text-center [overflow-wrap:anywhere] mt-2 mb-6">Ingresa con tu correo UNI y te enviaremos un código.</p>

      <form id="email-form" class="space-y-4">
        <input type="text" inputmode="email" autocapitalize="none" spellcheck="false" id="director-email" required autocomplete="email" placeholder="tu.correo@uni.pe" class="w-full bg-zinc-950 border border-zinc-700 focus:border-unicode focus:ring-1 focus:ring-unicode rounded-lg px-4 py-3 text-base text-white outline-none transition-all placeholder:text-zinc-600" />
        <button type="submit" id="email-btn" class="w-full bg-unicode hover:bg-unicode-light text-black font-bold text-[15px] py-3 rounded-lg transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer disabled:opacity-60">Enviar código</button>
      </form>

      <form id="code-form" class="hidden space-y-4">
        <input id="director-code" required inputmode="numeric" autocomplete="one-time-code" maxlength="6" pattern="[0-9]{6}" placeholder="Código de 6 dígitos" class="w-full bg-zinc-950 border border-zinc-700 focus:border-unicode focus:ring-1 focus:ring-unicode rounded-lg px-4 py-3 text-base text-white outline-none transition-all placeholder:text-zinc-600 text-center tracking-[0.4em] placeholder:tracking-normal text-lg" />
        <button type="submit" id="code-btn" class="w-full bg-unicode hover:bg-unicode-light text-black font-bold text-[15px] py-3 rounded-lg transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer disabled:opacity-60">Ingresar</button>
        <button type="button" id="change-email" class="min-h-11 w-full text-zinc-400 hover:text-white text-[14px] transition-colors cursor-pointer">Usar otro correo</button>
      </form>

      <form id="login-form" class="hidden space-y-4">
        <div>
          <input
            type="password"
            id="admin-password"
            name="password"
            placeholder="Contraseña"
            required
            autocomplete="current-password"
            class="w-full bg-zinc-950 border border-zinc-700 focus:border-unicode focus:ring-1 focus:ring-unicode rounded-lg px-4 py-3 text-base text-white outline-none transition-all placeholder:text-zinc-600"
          />
        </div>

        <button
          type="submit"
          id="login-btn"
          class="w-full bg-unicode hover:bg-unicode-light text-black font-bold text-[15px] py-3 rounded-lg transition-all duration-300 flex items-center justify-center gap-2 cursor-pointer"
        >
          <span id="login-btn-text">Ingresar con contraseña</span>
          <svg
            id="login-spinner"
            class="w-4 h-4 animate-spin hidden"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
          >
            <circle
              class="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="4"></circle>
            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
            ></path>
          </svg>
        </button>
      </form>

      <div id="login-error" role="alert" class="hidden mt-4 text-red-400 text-[14px] text-center font-medium py-2 px-3 bg-red-500/10 rounded-lg border border-red-500/20"></div>
      <p id="login-info" role="status" class="hidden mt-4 text-zinc-300 text-[14px] text-center [overflow-wrap:anywhere]"></p>
      <button type="button" id="toggle-password" class="hidden min-h-11 mx-auto mt-6 text-zinc-500 hover:text-zinc-300 text-[14px] underline underline-offset-4 cursor-pointer">Entrar con contraseña de administración</button>
    </div>
  </div>

  <div id="dashboard-screen" class="hidden min-h-screen">
    <header
      class="sticky top-0 z-50 bg-[#050505]/95 backdrop-blur-md border-b border-zinc-800/50"
    >
      <div
        class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between gap-3 min-h-16 sm:min-h-18 py-2"
      >
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          <img
            src="/logos/logo-unicode-blanco.webp"
            alt="Unicode"
            class="w-7 h-7 sm:w-8 sm:h-8 opacity-80"
          />
          <span class="text-white font-semibold text-[15px]"><span class="sm:hidden">Directores</span><span class="hidden sm:inline">Panel de directores</span></span>
        </div>
        <div class="flex items-center gap-3 sm:gap-5 min-w-0">
          <span id="session-user" class="hidden md:inline min-w-0 max-w-44 lg:max-w-64 text-zinc-500 text-[14px] truncate"></span>
          <a
            id="gth-panel-link"
            href="/admin/recruitment"
            aria-label="Panel de gestión de GTH"
            class="hidden min-h-11 content-center shrink-0 border border-zinc-700 hover:border-zinc-500 text-white text-[14px] sm:text-[15px] font-semibold px-3 sm:px-4 py-2 rounded-lg transition-colors whitespace-nowrap"
          >
            <span class="sm:hidden">GTH</span><span class="hidden sm:inline">Panel GTH</span>
          </a>
          <button
            id="logout-btn"
            class="min-h-11 min-w-11 shrink-0 text-zinc-400 hover:text-white text-[14px] font-medium transition-colors cursor-pointer whitespace-nowrap focus-visible:outline-2 focus-visible:outline-unicode focus-visible:outline-offset-4 rounded"
          >
            Salir
          </button>
        </div>
      </div>
    </header>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 pt-7 sm:pt-10 pb-12">
      <p id="admin-notice" role="status" hidden class="mb-6 flex items-start justify-between gap-4 rounded-xl border border-zinc-700 bg-zinc-900/60 px-4 py-3 text-[14px] text-zinc-200"><span></span><button id="admin-notice-close" type="button" aria-label="Cerrar aviso" class="shrink-0 text-zinc-500 hover:text-white cursor-pointer">✕</button></p>
      <div class="flex flex-wrap items-start justify-between gap-4 mb-7">
        <div class="min-w-0 flex-1">
          <p class="text-zinc-500 text-[12px] font-medium tracking-widest uppercase mb-2">Convocatoria UNICODE</p>
          <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">Postulaciones</h1>
          <p class="text-zinc-400 text-[14px] sm:text-[15px] mt-2">Revisa los perfiles y conoce a quienes quieren sumarse.</p>
        </div>
        <button id="export-btn" type="button" aria-label="Exportar Excel" class="min-h-11 min-w-11 shrink-0 inline-flex items-center justify-center gap-2 rounded-full border border-zinc-700 px-3 sm:px-4 py-2.5 text-[14px] font-medium text-zinc-300 hover:border-zinc-500 hover:text-white transition-colors cursor-pointer focus-visible:outline-2 focus-visible:outline-unicode focus-visible:outline-offset-4">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v12m0 0l-4-4m4 4l4-4M5 16v4a1 1 0 001 1h12a1 1 0 001-1v-4"></path></svg>
          <span class="hidden sm:inline">Exportar Excel</span><span class="hidden min-[360px]:inline sm:hidden">Exportar</span>
        </button>
      </div>
      <div id="admin-countdown-banner" class="hidden mb-6 rounded-2xl border border-unicode/30 bg-gradient-to-r from-unicode/10 via-zinc-900/70 to-zinc-900/40 p-4 sm:p-5 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-[0_0_30px_rgba(117,211,45,0.06)]">
        <div class="flex items-center gap-3.5 min-w-0">
          <div class="w-10 h-10 rounded-xl bg-unicode/15 border border-unicode/30 flex items-center justify-center text-unicode shrink-0 shadow-[0_0_15px_rgba(117,211,45,0.15)]">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
          </div>
          <div class="min-w-0">
            <div class="flex items-center gap-2">
              <h3 class="text-base font-semibold text-white tracking-tight">Cuenta regresiva de convocatoria</h3>
              <span id="countdown-status-badge" class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-unicode/20 text-unicode">En curso</span>
            </div>
            <p class="text-[13px] text-zinc-400 mt-0.5 truncate">Cierre programado: <span id="countdown-closes-label" class="text-zinc-200 font-medium"></span></p>
          </div>
        </div>
        <div id="countdown-timer-display" class="shrink-0 self-center sm:self-auto"></div>
      </div>
      <nav aria-label="Áreas de postulación" class="flex gap-1 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden border-b border-zinc-800 pb-3 mb-6">
        <button
          class="area-tab min-h-11 active-tab shrink-0 px-4 py-2 rounded-full text-[14px] font-medium transition-colors"
          data-area="summary"
        >
          Resumen
        </button>
        <span class="shrink-0 w-px my-2 bg-zinc-800" aria-hidden="true"></span>
        <button
          class="area-tab min-h-11 shrink-0 px-4 py-2 rounded-full text-[14px] font-medium transition-colors"
          data-area="GTH"
        >
          GTH
        </button>
        <button
          class="area-tab min-h-11 shrink-0 px-4 py-2 rounded-full text-[14px] font-medium transition-colors"
          data-area="ACD"
        >
          Académica
        </button>
        <button
          class="area-tab min-h-11 shrink-0 px-4 py-2 rounded-full text-[14px] font-medium transition-colors"
          data-area="ID"
        >
          ID
        </button>
        <button
          class="area-tab min-h-11 shrink-0 px-4 py-2 rounded-full text-[14px] font-medium transition-colors"
          data-area="RRPP"
        >
          RRPP
        </button>
        <button
          class="area-tab min-h-11 shrink-0 px-4 py-2 rounded-full text-[14px] font-medium transition-colors"
          data-area="DCC"
        >
          DCC
        </button>
        <button
          class="area-tab min-h-11 shrink-0 px-4 py-2 rounded-full text-[14px] font-medium transition-colors"
          data-area="LGE"
        >
          LGE
        </button>
        <button
          class="area-tab min-h-11 shrink-0 px-4 py-2 rounded-full text-[14px] font-medium transition-colors"
          data-area="FIN"
        >
          Finanzas
        </button>
      </nav>

      <section id="summary-view" aria-labelledby="summary-title">
        <h2 id="summary-title" class="sr-only">Resumen de la convocatoria</h2>
        <div id="summary-loading" class="py-16 text-center text-zinc-500 text-[15px]">Cargando resumen…</div>
        <div id="summary-error" class="hidden py-16 text-center"><p class="text-red-400" id="summary-error-message"></p><button id="summary-retry" class="mt-4 text-unicode text-[15px] underline cursor-pointer">Reintentar</button></div>
        <div id="summary-content" class="hidden space-y-4"></div>
      </section>

      <div id="area-view" class="hidden">
      <div
        class="grid grid-cols-1 min-[480px]:grid-cols-2 lg:grid-cols-[minmax(0,1fr)_220px_220px] gap-3 mb-6"
      >
        <label class="min-[480px]:col-span-2 lg:col-span-1 text-zinc-500 text-[12px] grid gap-2">
          Buscar postulante
          <div class="relative">
            <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-zinc-500 pointer-events-none" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path stroke-linecap="round" d="m16 16 4 4"></path></svg>
            <input id="applicant-search" type="search" placeholder="Nombre o correo" class="w-full min-h-11 rounded-xl border border-zinc-800 bg-zinc-900/40 py-2.5 pl-10 pr-3 text-base text-white placeholder:text-zinc-500 outline-none focus:border-unicode transition-colors" />
          </div>
        </label>
        <AdminSelect id="filter-option" label="Preferencia" options={[
          { value: "all", label: "Todas las opciones" },
          { value: "first", label: "Solo 1ra opción" },
          { value: "second", label: "Solo 2da opción" },
        ]} />
        <AdminSelect id="filter-order" label="Orden" options={[
          { value: "arrival", label: "Orden de llegada" },
          { value: "recent", label: "Más recientes" },
        ]} />
      </div>

      <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
        <h2 id="area-label" class="text-base font-semibold text-zinc-200">Área de GTH</h2>
        <p id="results-info" role="status" aria-live="polite" class="text-zinc-500 text-[14px]"><span id="count" class="text-zinc-300 font-medium">0</span> <span id="count-label">postulantes</span></p>
      </div>

      <div
        id="loading-indicator"
        class="flex items-center justify-center py-20"
      >
        <div class="flex flex-col items-center gap-3">
          <svg
            class="w-8 h-8 animate-spin text-unicode"
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
          >
            <circle
              class="opacity-25"
              cx="12"
              cy="12"
              r="10"
              stroke="currentColor"
              stroke-width="4"></circle>
            <path
              class="opacity-75"
              fill="currentColor"
              d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
            ></path>
          </svg>
          <p class="text-zinc-500 text-[15px]">Cargando postulantes...</p>
        </div>
      </div>

      <div id="empty-state" class="hidden text-center py-16 rounded-2xl border border-dashed border-zinc-800">
        <p id="empty-message" class="text-zinc-400 text-[15px]">No hay postulantes para esta área.</p>
        <p id="empty-hint" class="text-zinc-500 text-[14px] mt-2">Las postulaciones aparecerán aquí cuando estén completas.</p>
      </div>

      <div id="error-state" class="hidden text-center py-20">
        <p class="text-red-400 text-base" id="error-message">
          Error al cargar los datos.
        </p>
        <button
          id="retry-btn"
          class="mt-4 text-unicode text-[15px] underline hover:text-unicode-light cursor-pointer"
        >
          Reintentar
        </button>
      </div>

      <div id="applicants-list" class="hidden space-y-3" aria-busy="false"></div>
      </div>
    </main>

    <dialog id="applicant-detail" aria-labelledby="applicant-detail-title" class="fixed inset-y-0 left-auto right-0 m-0 w-full sm:max-w-[680px] max-w-full h-dvh max-h-dvh overflow-y-auto overscroll-contain border-0 border-l border-zinc-800 bg-[#0c0c0e] text-white p-0 backdrop:bg-black/70 backdrop:backdrop-blur-sm scheme-dark">
      <header class="sticky top-0 z-10 flex items-start justify-between gap-4 border-b border-zinc-800 bg-[#0c0c0e]/95 backdrop-blur-sm px-5 sm:px-7 py-5">
        <div class="min-w-0">
          <p class="text-zinc-500 text-[12px] tracking-widest uppercase mb-2">Ficha de postulación</p>
          <h2 id="applicant-detail-title" class="text-lg sm:text-xl font-semibold leading-snug break-words"></h2>
          <p id="applicant-detail-date" class="text-zinc-500 text-[14px] mt-2"></p>
        </div>
        <button id="close-applicant-detail" type="button" aria-label="Cerrar ficha" class="shrink-0 flex items-center justify-center w-11 h-11 rounded-full border border-zinc-800 text-zinc-400 hover:text-white hover:border-zinc-600 cursor-pointer focus-visible:outline-2 focus-visible:outline-unicode focus-visible:outline-offset-4">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" d="m6 6 12 12M6 18 18 6"></path></svg>
        </button>
      </header>
      <div id="applicant-detail-content" class="p-5 sm:p-7 space-y-7"></div>
    </dialog>
  </div>
  </div>
</Layout>

<style>
  .area-tab[data-count]::after {
    content: attr(data-count);
    margin-left: 0.45rem;
    font-size: 12px;
    color: #71717a;
    font-variant-numeric: tabular-nums;
  }
  .area-tab.active-tab[data-count]::after { color: inherit; opacity: 0.7; }
  .area-tab {
    background: transparent;
    color: #a1a1aa; /* zinc-400 */
    border: 1px solid transparent;
    cursor: pointer;
  }
  .area-tab:hover {
    background: #18181b;
    color: #d4d4d8;
  }
  .area-tab.active-tab {
    background: #75d32d15;
    color: #94e65a;
    border-color: #75d32d30;
  }
  .area-tab:focus-visible {
    outline: 2px solid #75d32d;
    outline-offset: -2px;
  }

  :global(#admin-page :is(button, a, input, summary, .applicant-card)) {
    transition-property: color, background-color, border-color, opacity, box-shadow;
    transition-duration: 150ms;
    transition-timing-function: ease-out;
  }
  :global(#admin-page button:disabled) {
    cursor: default;
    opacity: 0.5;
  }
  #login-screen:not(.hidden),
  #dashboard-screen:not(.hidden) main,
  #email-form:not(.hidden),
  #code-form:not(.hidden),
  #login-form:not(.hidden),
  #applicants-list:not(.hidden),
  #empty-state:not(.hidden),
  #error-state:not(.hidden),
  #summary-view:not(.hidden) #summary-content:not(.hidden),
  #area-view:not(.hidden),
  #admin-notice:not([hidden]) {
    animation: admin-enter 200ms ease-out;
  }
  #login-screen:not(.hidden) > div {
    animation: admin-card-in 260ms ease-out;
  }
  @keyframes admin-enter {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes admin-card-in {
    from { opacity: 0; transform: translateY(8px) scale(0.99); }
    to { opacity: 1; transform: none; }
  }
  #dashboard-screen {
    transition: opacity 180ms ease-in, transform 180ms ease-in;
  }
  #dashboard-screen.is-leaving {
    opacity: 0;
    transform: translateY(-4px);
  }
  :global(#summary-content > div > div) {
    animation: admin-enter 240ms ease-out backwards;
  }
  :global(#summary-content > div:nth-child(2) > div) { animation-delay: 40ms; }
  :global(#summary-content > div:nth-child(3) > div) { animation-delay: 80ms; }
  :global(#summary-content [style*="width"]) {
    transition: width 500ms ease-out;
  }
  :global(#admin-page [data-admin-options]) {
    opacity: 1;
    transform: translateY(0);
    transition: opacity 140ms ease-out, transform 140ms ease-out, display 140ms allow-discrete;
  }
  :global(#admin-page [data-admin-options][hidden]) {
    display: none;
    opacity: 0;
    transform: translateY(-3px);
  }
  #applicant-detail {
    opacity: 0;
    transform: translateX(10px);
    transition: opacity 180ms ease-out, transform 180ms ease-out, display 180ms allow-discrete, overlay 180ms allow-discrete;
  }
  #applicant-detail[open] {
    opacity: 1;
    transform: translateX(0);
  }
  #applicant-detail::backdrop {
    background-color: transparent;
    transition: background-color 180ms ease-out, display 180ms allow-discrete, overlay 180ms allow-discrete;
  }
  #applicant-detail[open]::backdrop {
    background-color: rgb(0 0 0 / 0.7);
  }
  :global(#applicant-detail details[open] ol) {
    animation: admin-enter 150ms ease-out;
  }
  @starting-style {
    :global(#admin-page [data-admin-options]:not([hidden])) {
      opacity: 0;
      transform: translateY(-3px);
    }
    #applicant-detail[open] {
      opacity: 0;
      transform: translateX(10px);
    }
    #applicant-detail[open]::backdrop {
      background-color: transparent;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto !important; }
    :global(#admin-page *), :global(#admin-page *::before), :global(#admin-page *::after),
    #applicant-detail::backdrop {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }

  :global(footer) {
    display: none !important;
  }
</style>

<script>
  import { applicantListMarkup, applicantDetailMarkup, applicantName, applicantDate, type Applicant } from "../scripts/admin-applicant-view";
  import { setupAdminSelects } from "../scripts/admin-select";
  const closeFilters = setupAdminSelects();

  let sessionToken = "";
  /** The session survives closing the tab or the browser (it lasts two days on the server). */
  const storedToken = {
    get: () => { try { return localStorage.getItem("admin_token") || sessionStorage.getItem("admin_token"); } catch { return null; } },
    set: (value: string) => { try { localStorage.setItem("admin_token", value); } catch { /* Storage blocked: this tab only. */ } },
    clear: () => { try { localStorage.removeItem("admin_token"); sessionStorage.removeItem("admin_token"); } catch { /* Storage blocked. */ } },
  };
  let currentArea = "GTH";
  let currentView: "summary" | "area" = "summary";
  let currentOption = "all";
  let currentOrder = "arrival";
  let applicantsCache: Applicant[] = [];
  let displayedApplicants: Applicant[] = [];
  let loadVersion = 0;
  let lastDetailButton: HTMLButtonElement | null = null;
  const searchInput = document.getElementById("applicant-search") as HTMLInputElement;
  const detailDialog = document.getElementById("applicant-detail") as HTMLDialogElement;
  const closeDetailButton = document.getElementById("close-applicant-detail") as HTMLButtonElement;

  function closeDetail() {
    if (detailDialog.open) detailDialog.close();
  }
  closeDetailButton.addEventListener("click", closeDetail);
  detailDialog.addEventListener("close", () => {
    document.documentElement.style.overflow = "";
    if (lastDetailButton?.isConnected) lastDetailButton.focus({ preventScroll: true });
    // Keep the content through the native closing transition; reduced motion settles immediately.
    Promise.allSettled(detailDialog.getAnimations().map((animation) => animation.finished)).then(() => {
      if (!detailDialog.open) document.getElementById("applicant-detail-content")!.replaceChildren();
    });
  });
  detailDialog.addEventListener("click", (event) => {
    const bounds = detailDialog.getBoundingClientRect();
    if (event.target === detailDialog && (event.clientX < bounds.left || event.clientX > bounds.right)) closeDetail();
  });

  document.getElementById("applicants-list")!.addEventListener("click", (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".detail-button");
    if (!button) return;
    const applicant = displayedApplicants[Number(button.dataset.index)];
    if (!applicant) return;
    closeFilters();
    lastDetailButton = button;
    document.getElementById("applicant-detail-title")!.textContent = applicantName(applicant);
    document.getElementById("applicant-detail-date")!.textContent = `Registrado el ${applicantDate(applicant.created_at, true)}`;
    document.getElementById("applicant-detail-content")!.innerHTML = applicantDetailMarkup(applicant);
    detailDialog.showModal();
    detailDialog.scrollTop = 0;
    document.documentElement.style.overflow = "hidden";
    closeDetailButton.focus({ preventScroll: true });
  });

  function applySearch() {
    closeDetail();
    const query = searchInput.value.trim().toLocaleLowerCase("es");
    displayedApplicants = applicantsCache.filter((applicant) => !query || `${applicantName(applicant)} ${applicant.email}`.toLocaleLowerCase("es").includes(query));
    const count = displayedApplicants.length;
    document.getElementById("count")!.textContent = String(count);
    document.getElementById("count-label")!.textContent = `${count === 1 ? "postulante" : "postulantes"}${query ? ` de ${applicantsCache.length}` : ""}`;
    document.getElementById("empty-message")!.textContent = query ? "No encontramos postulantes con esa búsqueda." : "No hay postulantes con estos filtros.";
    document.getElementById("empty-hint")!.textContent = query ? "Prueba con otro nombre o correo." : "Puedes consultar otra área o cambiar la preferencia.";
    document.getElementById("empty-state")!.classList.toggle("hidden", count > 0);
    document.getElementById("applicants-list")!.classList.toggle("hidden", count === 0);
    renderApplicants(displayedApplicants);
    (document.getElementById("export-btn") as HTMLButtonElement).disabled = count === 0;
  }
  searchInput.addEventListener("input", applySearch);

  const areaNames: Record<string, string> = {
    GTH: "Área de GTH",
    ACD: "Área Académica",
    ID: "Área de ID",
    RRPP: "Área RRPP",
    DCC: "Área DCC",
    LGE: "Área LGE",
    FIN: "Finanzas",
  };
  /** Applicant text is untrusted: escape it before building HTML for cards and the export. */
  const esc = (value: unknown) => String(value ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);

  const loginScreen = document.getElementById("login-screen")!;
  const dashboardScreen = document.getElementById("dashboard-screen")!;
  const loginForm = document.getElementById("login-form") as HTMLFormElement;
  const loginBtn = document.getElementById("login-btn") as HTMLButtonElement;
  const loginBtnText = document.getElementById("login-btn-text")!;
  const loginSpinner = document.getElementById("login-spinner")!;
  const loginError = document.getElementById("login-error")!;
  const passwordInput = document.getElementById(
    "admin-password",
  ) as HTMLInputElement;

  const emailForm = document.getElementById("email-form") as HTMLFormElement;
  const codeForm = document.getElementById("code-form") as HTMLFormElement;
  const emailInput = document.getElementById("director-email") as HTMLInputElement;
  const codeInput = document.getElementById("director-code") as HTMLInputElement;
  const loginInfo = document.getElementById("login-info")!;
  const loginIntro = document.getElementById("login-intro")!;
  type Session = { role: "admin" } | { role: "director"; email: string; area: string; name?: string };

  const showError = (text: string) => { loginError.textContent = text; loginError.classList.remove("hidden"); loginInfo.classList.add("hidden"); };
  const showInfo = (text: string) => { loginInfo.textContent = text; loginInfo.classList.remove("hidden"); loginError.classList.add("hidden"); };
  function showStep(step: "email" | "code" | "password") {
    emailForm.classList.toggle("hidden", step !== "email");
    codeForm.classList.toggle("hidden", step !== "code");
    loginForm.classList.toggle("hidden", step !== "password");
    // The shared password is reached by typing "admin" as the email; this link only leads back.
    const back = document.getElementById("toggle-password")!;
    back.textContent = "Entrar con mi correo UNI";
    back.classList.toggle("hidden", step !== "password");
    back.classList.toggle("block", step === "password");
    loginIntro.textContent = step === "password" ? "Acceso de super admin con la contraseña de administración." : step === "code" ? `Escribe el código que enviamos a ${emailInput.value.trim()}.` : "Ingresa con tu correo UNI y te enviaremos un código.";
    loginError.classList.add("hidden");
    (step === "email" ? emailInput : step === "code" ? codeInput : passwordInput).focus();
  }
  document.getElementById("toggle-password")!.addEventListener("click", () => { emailInput.value = ""; showStep("email"); });
  document.getElementById("change-email")!.addEventListener("click", () => { codeInput.value = ""; showStep("email"); });

  /** Every director sees all areas, starting on their own; GTH and the super admin also reach the GTH panel. */
  function applySession(session: Session) {
    const managesCall = session.role === "admin" || session.area === "GTH";
    document.getElementById("gth-panel-link")!.classList.toggle("hidden", !managesCall);
    const user = document.getElementById("session-user")!;
    user.textContent = session.role === "director" ? session.email : "Super admin";
    if (session.role === "director" && areaNames[session.area]) currentArea = session.area;
    currentView = "summary";
    markActiveTab("summary");
    document.getElementById("area-label")!.textContent = areaNames[currentArea] || currentArea;
  }
  function markActiveTab(key: string) {
    document.querySelectorAll<HTMLElement>(".area-tab").forEach((tab) => {
      const active = tab.dataset.area === key;
      tab.classList.toggle("active-tab", active);
      tab.setAttribute("aria-pressed", String(active));
      if (active) tab.scrollIntoView({ block: "nearest", inline: "nearest" });
    });
  }
  /** The summary opens first; each area tab shows that area's applications. */
  function showView(view: "summary" | "area") {
    currentView = view;
    document.getElementById("summary-view")!.classList.toggle("hidden", view !== "summary");
    document.getElementById("area-view")!.classList.toggle("hidden", view !== "area");
    document.getElementById("export-btn")!.hidden = view !== "area";
    if (view === "summary") void loadSummary(); else loadApplicants();
  }
  function startSession(token: string, session: Session) {
    sessionToken = token;
    storedToken.set(token);
    loginScreen.classList.add("hidden");
    dashboardScreen.classList.remove("hidden");
    applySession(session);
    // Coming back from the GTH panel's sign-in: return there if this session may manage the call.
    const params = new URLSearchParams(location.search);
    const managesCall = session.role === "admin" || session.area === "GTH";
    if (params.get("volver") === "gth" && managesCall) { location.replace("/admin/recruitment"); return; }
    if (params.has("sin_gth") || params.get("volver") === "gth") showNotice("El Panel GTH es solo para directores de GTH. Aquí puedes ver todas las postulaciones.");
    if (location.search) history.replaceState(null, "", "/admin");
    showView("summary");
  }
  function showNotice(text: string) {
    const notice = document.getElementById("admin-notice")!;
    notice.querySelector("span")!.textContent = text;
    notice.hidden = false;
  }

  emailForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (emailInput.value.trim().toLowerCase() === "admin") { showStep("password"); return; }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(emailInput.value.trim())) { showError("Escribe tu correo UNI completo."); return; }
    const button = document.getElementById("email-btn") as HTMLButtonElement;
    button.disabled = true; button.textContent = "Enviando...";
    try {
      const res = await fetch("/api/admin-code", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email: emailInput.value.trim() }) });
      const data = await res.json();
      if (!res.ok) { showError(data.error || "No se pudo enviar el código."); return; }
      showStep("code");
      showInfo(data.message);
    } catch { showError("Error de conexión. Intenta de nuevo."); }
    finally { button.disabled = false; button.textContent = "Enviar código"; }
  });

  codeForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const button = document.getElementById("code-btn") as HTMLButtonElement;
    button.disabled = true; button.textContent = "Verificando...";
    try {
      const res = await fetch("/api/admin-login", { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ email: emailInput.value.trim(), code: codeInput.value.trim() }) });
      const data = await res.json();
      if (!res.ok) { showError(data.error || "Código incorrecto."); codeInput.select(); return; }
      codeInput.value = "";
      startSession(data.token, data.session);
    } catch { showError("Error de conexión. Intenta de nuevo."); }
    finally { button.disabled = false; button.textContent = "Ingresar"; }
  });

  loginForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const password = passwordInput.value.trim();
    if (!password) return;

    loginBtn.disabled = true;
    loginBtnText.textContent = "Verificando...";
    loginSpinner.classList.remove("hidden");
    loginError.classList.add("hidden");

    try {
      const res = await fetch("/api/admin-login", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ password }),
      });

      const data = await res.json();

      if (!res.ok) {
        loginError.textContent = data.error || "Error al iniciar sesión.";
        if (data.attemptsRemaining) {
          loginError.textContent += ` (${data.attemptsRemaining} intentos restantes)`;
        }
        loginError.classList.remove("hidden");
        passwordInput.value = "";
        passwordInput.focus();
        return;
      }

      passwordInput.value = "";
      startSession(data.token, data.session || { role: "admin" });
    } catch (err) {
      loginError.textContent = "Error de conexión. Intenta de nuevo.";
      loginError.classList.remove("hidden");
    } finally {
      loginBtn.disabled = false;
      loginBtnText.textContent = "Ingresar con contraseña";
      loginSpinner.classList.add("hidden");
    }
  });

  /** A short fade so leaving the panel does not feel abrupt; instant with reduced motion. */
  function fadeOut(element: HTMLElement): Promise<void> {
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return Promise.resolve();
    element.classList.add("is-leaving");
    return new Promise((resolve) => setTimeout(() => { element.classList.remove("is-leaving"); resolve(); }, 180));
  }
  function expireSession() {
    sessionToken = "";
    storedToken.clear();
    dashboardScreen.classList.add("hidden");
    loginScreen.classList.remove("hidden");
    showStep("email");
    showError("Tu sesión venció. Ingresa de nuevo.");
  }

  document.getElementById("admin-notice-close")!.addEventListener("click", () => (document.getElementById("admin-notice")!.hidden = true));
  if (new URLSearchParams(location.search).has("expirada")) showError("Tu sesión venció. Ingresa de nuevo.");

  // ===== CHECK EXISTING SESSION =====
  const savedToken = storedToken.get();
  if (savedToken) {
    // Ask the server who this token belongs to; an expired token goes back to the sign-in.
    fetch("/api/recruitment/admin/session", { headers: { Authorization: `Bearer ${savedToken}` } })
      .then(async (res) => {
        if (!res.ok) { storedToken.clear(); return; }
        startSession(savedToken, (await res.json()).session);
      })
      .catch(() => showError("Error de conexión. Recarga la página."));
  }

  document.getElementById("logout-btn")?.addEventListener("click", async () => {
    loadVersion++;
    closeFilters();
    closeDetail();
    try {
      await fetch("/api/admin-logout", {
        method: "POST",
        headers: { Authorization: `Bearer ${sessionToken}` },
      });
    } catch {
      /* ignore */
    }

    sessionToken = "";
    applicantsCache = [];
    displayedApplicants = [];
    await fadeOut(dashboardScreen);
    document.getElementById("applicants-list")!.replaceChildren();
    document.getElementById("summary-content")!.replaceChildren();
    storedToken.clear();
    dashboardScreen.classList.add("hidden");
    loginScreen.classList.remove("hidden");
    passwordInput.value = "";
    showStep("email");
  });

  function openArea(area: string) {
    currentArea = area;
    markActiveTab(area);
    document.getElementById("area-label")!.textContent = areaNames[currentArea] || currentArea;
    showView("area");
  }
  document.querySelectorAll<HTMLElement>(".area-tab").forEach((tab) => {
    tab.addEventListener("click", () => {
      const key = tab.dataset.area || "summary";
      if (key === "summary") { markActiveTab("summary"); showView("summary"); } else openArea(key);
    });
  });

  // ===== SUMMARY =====
  type Metrics = {
    opensAt: string | null; closesAt: string | null;
    totals: { submitted: number; inProgress: number; recordingStarted: number; expired: number };
    stages: { pendingReview: number; advanced: number; rejected: number; joined: number; notJoined: number };
    areas: { id: string; name: string; first: number; second: number }[];
    referral: { label: string; count: number }[]; universities: { label: string; count: number }[];
    semesters: { label: string; count: number }[]; daily: { day: string; count: number }[]; averageHours: number | null;
  };
  let summaryVersion = 0;
  let countdownInterval: number | undefined;
  function updateCountdown(targetIso: string | null) {
    if (countdownInterval) clearInterval(countdownInterval);
    const banner = document.getElementById("admin-countdown-banner");
    const container = document.getElementById("countdown-timer-display");
    const badge = document.getElementById("countdown-status-badge");
    const closesLabel = document.getElementById("countdown-closes-label");
    if (!container) return;
    if (banner) banner.classList.add("hidden");
    if (!targetIso) {
      if (closesLabel) closesLabel.textContent = "sin fecha definida";
      container.innerHTML = `<span class="text-zinc-500 text-[13px]">Sin fecha límite configurada</span>`;
      if (badge) { badge.textContent = "Sin fecha"; badge.className = "inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-zinc-800 text-zinc-400"; }
      return;
    }
    const target = new Date(targetIso).getTime();
    if (Number.isNaN(target)) {
      if (closesLabel) closesLabel.textContent = "sin fecha";
      container.innerHTML = `<span class="text-zinc-500 text-[13px]">Fecha no válida</span>`;
      return;
    }
    if (closesLabel) {
      closesLabel.textContent = new Date(targetIso).toLocaleString("es-PE", { timeZone: "America/Lima", day: "numeric", month: "long", hour: "2-digit", minute: "2-digit" });
    }

    const tick = () => {
      const diff = target - Date.now();
      banner?.classList.toggle("hidden", diff <= 0 || diff > 86_400_000);
      if (diff > 86_400_000) return;
      if (diff <= 0) {
        container.innerHTML = `<span class="text-red-400 font-semibold text-sm flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-red-500"></span>Convocatoria cerrada</span>`;
        if (badge) { badge.textContent = "Finalizada"; badge.className = "inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-red-950/80 text-red-400 border border-red-800/60"; }
        if (countdownInterval) clearInterval(countdownInterval);
        return;
      }
      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
      const minutes = Math.floor((diff / (1000 * 60)) % 60);
      const seconds = Math.floor((diff / 1000) % 60);
      const pad = (v: number) => String(v).padStart(2, "0");

      container.innerHTML = `
        <div class="flex items-center gap-1.5 sm:gap-2">
          <div class="flex flex-col items-center justify-center bg-zinc-950/90 border border-zinc-800 rounded-xl px-2.5 py-1 min-w-[48px] sm:min-w-[54px] shadow-inner">
            <span class="text-lg sm:text-xl font-bold font-mono text-unicode tabular-nums leading-tight">${days}</span>
            <span class="text-[10px] text-zinc-500 uppercase tracking-wider">días</span>
          </div>
          <span class="text-zinc-600 font-bold">:</span>
          <div class="flex flex-col items-center justify-center bg-zinc-950/90 border border-zinc-800 rounded-xl px-2.5 py-1 min-w-[48px] sm:min-w-[54px] shadow-inner">
            <span class="text-lg sm:text-xl font-bold font-mono text-zinc-100 tabular-nums leading-tight">${pad(hours)}</span>
            <span class="text-[10px] text-zinc-500 uppercase tracking-wider">h</span>
          </div>
          <span class="text-zinc-600 font-bold">:</span>
          <div class="flex flex-col items-center justify-center bg-zinc-950/90 border border-zinc-800 rounded-xl px-2.5 py-1 min-w-[48px] sm:min-w-[54px] shadow-inner">
            <span class="text-lg sm:text-xl font-bold font-mono text-zinc-100 tabular-nums leading-tight">${pad(minutes)}</span>
            <span class="text-[10px] text-zinc-500 uppercase tracking-wider">m</span>
          </div>
          <span class="text-zinc-600 font-bold">:</span>
          <div class="flex flex-col items-center justify-center bg-zinc-950/90 border border-zinc-800 rounded-xl px-2.5 py-1 min-w-[48px] sm:min-w-[54px] shadow-inner">
            <span class="text-lg sm:text-xl font-bold font-mono text-zinc-100 tabular-nums leading-tight">${pad(seconds)}</span>
            <span class="text-[10px] text-zinc-500 uppercase tracking-wider">s</span>
          </div>
        </div>
      `;
    };
    tick();
    countdownInterval = window.setInterval(tick, 1000);
  }

  async function loadSummary() {
    const version = ++summaryVersion;
    const content = document.getElementById("summary-content")!;
    document.getElementById("summary-loading")!.classList.toggle("hidden", !content.classList.contains("hidden"));
    document.getElementById("summary-error")!.classList.add("hidden");
    try {
      const res = await fetch("/api/admin-metrics", { headers: { Authorization: `Bearer ${sessionToken}` } });
      if (version !== summaryVersion) return;
      if (res.status === 401) { expireSession(); return; }
      const data = await res.json();
      if (!res.ok) throw new Error(data.error || "No se pudo cargar el resumen.");
      content.innerHTML = summaryMarkup(data as Metrics);
      updateCountdown((data as Metrics).closesAt);
      content.classList.remove("hidden");
      for (const area of (data as Metrics).areas) {
        const tab = document.querySelector<HTMLElement>(`.area-tab[data-area="${area.id}"]`);
        if (tab) tab.dataset.count = String(area.first);
      }
    } catch (error) {
      if (version !== summaryVersion) return;
      document.getElementById("summary-error-message")!.textContent = error instanceof Error ? error.message : "No se pudo cargar el resumen.";
      document.getElementById("summary-error")!.classList.remove("hidden");
    } finally {
      if (version === summaryVersion) document.getElementById("summary-loading")!.classList.add("hidden");
    }
  }
  document.getElementById("summary-retry")!.addEventListener("click", () => void loadSummary());
  document.getElementById("summary-content")!.addEventListener("click", (event) => {
    const area = (event.target as HTMLElement).closest<HTMLElement>("[data-open-area]")?.dataset.openArea;
    if (area) openArea(area);
  });

  const card = (body: string, extra = "") => `<div class="rounded-2xl border border-zinc-800 bg-zinc-900/30 p-5 sm:p-6 min-w-0 ${extra}">${body}</div>`;
  const cardTitle = (title: string, hint = "") => `<div class="flex items-baseline justify-between gap-3 mb-4"><h3 class="text-[15px] font-semibold text-zinc-200">${title}</h3>${hint ? `<span class="text-zinc-500 text-[12px]">${hint}</span>` : ""}</div>`;
  function bars(items: { label: string; count: number }[], empty: string) {
    if (!items.length) return `<p class="text-zinc-500 text-[14px]">${empty}</p>`;
    const max = Math.max(...items.map((item) => item.count), 1);
    return `<ul class="space-y-3">${items.map((item) => `<li><div class="flex justify-between gap-3 text-[14px] mb-1.5"><span class="text-zinc-300 truncate">${esc(item.label)}</span><span class="text-zinc-400 tabular-nums">${item.count}</span></div><div class="h-1.5 rounded-full bg-zinc-800 overflow-hidden"><div class="h-full rounded-full bg-unicode/80" style="width:${Math.max(4, item.count / max * 100)}%"></div></div></li>`).join("")}</ul>`;
  }
  function kpi(label: string, value: number | string, detail: string, accent = false) {
    return card(`<p class="text-zinc-500 text-[13px]">${label}</p><p class="mt-2 text-3xl sm:text-4xl font-bold tracking-tight tabular-nums ${accent ? "text-unicode" : "text-white"}">${value}</p><p class="mt-2 text-zinc-500 text-[13px]">${detail}</p>`);
  }
  function summaryMarkup(m: Metrics) {
    const closes = m.closesAt ? new Date(m.closesAt).toLocaleString("es-PE", { timeZone: "America/Lima", day: "numeric", month: "long", hour: "2-digit", minute: "2-digit" }) : "sin fecha";
    const maxArea = Math.max(...m.areas.map((area) => area.first + area.second), 1);
    const maxDay = Math.max(...m.daily.map((day) => day.count), 1);
    const reviewed = m.stages.advanced + m.stages.rejected;
    const firstDay = m.daily[0]?.day ? m.daily[0].day.slice(5).split("-").reverse().join("/") : "";
    const totalDays = m.daily.length;
    const dailyHint = totalDays ? `${totalDays} ${totalDays === 1 ? "día" : "días"} · desde el inicio (${firstDay})` : "sin registros";
    return `
      <div class="grid grid-cols-1 min-[520px]:grid-cols-2 xl:grid-cols-4 gap-4">
        ${kpi("Inscripciones completas", m.totals.submitted, `La convocatoria cierra el ${esc(closes)}`, true)}
        ${kpi("En proceso", m.totals.inProgress, `${m.totals.recordingStarted} ya empezaron su video`)}
        ${kpi("Avanzan a la 2.ª etapa", m.stages.advanced, `${m.stages.pendingReview} por revisar · ${m.stages.rejected} no avanzan`)}
        ${kpi("Ingresan a UNICODE", m.stages.joined, `${m.stages.notJoined} no ingresan`, m.stages.joined > 0)}
      </div>
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,3fr)_minmax(0,2fr)] gap-4">
        ${card(cardTitle("Postulantes por área", `<span class="inline-flex items-center gap-1.5"><span class="w-2 h-2 rounded-full bg-unicode"></span>1ra</span> <span class="inline-flex items-center gap-1.5 ml-3"><span class="w-2 h-2 rounded-full bg-zinc-500"></span>2da</span>`) + `<ul class="space-y-1">${m.areas.map((area) => `<li><button type="button" data-open-area="${esc(area.id)}" class="w-full text-left rounded-xl px-2 py-2.5 -mx-2 hover:bg-zinc-800/50 cursor-pointer focus-visible:outline-2 focus-visible:outline-unicode"><div class="flex justify-between gap-3 text-[14px] mb-1.5"><span class="text-zinc-200 truncate">${esc(area.name)}</span><span class="text-zinc-400 tabular-nums shrink-0">${area.first} <span class="text-zinc-600">+ ${area.second}</span></span></div><div class="flex h-2 rounded-full bg-zinc-800 overflow-hidden"><div class="h-full bg-unicode" style="width:${area.first / maxArea * 100}%"></div><div class="h-full bg-zinc-500" style="width:${area.second / maxArea * 100}%"></div></div></button></li>`).join("")}</ul><p class="text-zinc-500 text-[12px] mt-3">Toca un área para ver sus postulaciones.</p>`)}
        ${card(cardTitle("Inscripciones por día", dailyHint) + `
          <div class="overflow-x-auto [scrollbar-width:thin] pb-1 -mx-1 px-1">
            <div class="flex items-end gap-1.5 h-40 min-w-full" style="min-width: ${Math.max(120, m.daily.length * 20)}px" role="img" aria-label="Inscripciones completas por día">
              ${m.daily.map((day) => `
                <div class="flex-1 h-full flex flex-col justify-end items-center gap-1.5 min-w-[14px]" title="${esc(day.day)}: ${day.count} ${day.count === 1 ? "inscripción" : "inscripciones"}">
                  <span class="text-[11px] text-zinc-500 tabular-nums">${day.count || ""}</span>
                  <div class="w-full rounded-t-md transition-all ${day.count ? "bg-unicode/80 hover:bg-unicode" : "bg-zinc-800"}" style="height:${day.count ? Math.max(6, day.count / maxDay * 100) : 3}%"></div>
                </div>
              `).join("")}
            </div>
          </div>
          <div class="flex justify-between text-[11px] text-zinc-500 mt-2">
            <span>Inicio: ${esc(firstDay)}</span>
            <span>Hoy (${m.daily[m.daily.length - 1]?.count ?? 0})</span>
          </div>
        `)}
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        ${card(cardTitle("Cómo se enteraron") + bars(m.referral, "Aún no hay respuestas."))}
        ${card(cardTitle("Centro de estudios") + bars(m.universities, "Aún no hay inscripciones."))}
        ${card(cardTitle("Ciclo", m.averageHours != null ? `${m.averageHours} h/semana en promedio` : "") + bars(m.semesters, "Aún no hay inscripciones."))}
      </div>
      <p class="text-zinc-600 text-[12px]">${reviewed} de ${m.totals.submitted} perfiles revisados.</p>`;
  }

  document.getElementById("filter-option")?.addEventListener("change", (e) => {
    currentOption = (e.target as HTMLElement).dataset.value || "all";
    loadApplicants();
  });

  document.getElementById("filter-order")?.addEventListener("change", (e) => {
    currentOrder = (e.target as HTMLElement).dataset.value || "arrival";
    loadApplicants();
  });

  async function loadApplicants() {
    const version = ++loadVersion;
    let loaded = false;
    closeFilters();
    closeDetail();
    const loadingEl = document.getElementById("loading-indicator")!;
    const emptyEl = document.getElementById("empty-state")!;
    const errorEl = document.getElementById("error-state")!;
    const listEl = document.getElementById("applicants-list")!;

    loadingEl.classList.remove("hidden");
    emptyEl.classList.add("hidden");
    errorEl.classList.add("hidden");
    listEl.classList.add("hidden");
    listEl.setAttribute("aria-busy", "true");
    searchInput.disabled = true;
    (document.getElementById("export-btn") as HTMLButtonElement).disabled = true;
    document.getElementById("count")!.textContent = "—";
    document.getElementById("count-label")!.textContent = "postulantes";
    applicantsCache = [];
    displayedApplicants = [];

    try {
      const params = new URLSearchParams({
        area: currentArea,
        option: currentOption,
        order: currentOrder,
      });

      const res = await fetch(`/api/admin-applicants?${params}`, {
        headers: { Authorization: `Bearer ${sessionToken}` },
      });
      if (version !== loadVersion) return;

      if (res.status === 401) { expireSession(); return; }

      if (!res.ok) {
        // Try to get JSON error first
        const contentType = res.headers.get("content-type");
        if (contentType && contentType.includes("application/json")) {
          const errData = await res.json();
          throw new Error(errData.error || `Error ${res.status}`);
        } else {
          // If not JSON, it's likely an HTML error page (500, 404, etc.)
          const text = await res.text();
          console.error("HTML Error Response:", text);
          throw new Error(
            `Error del servidor (${res.status}). Revisa la consola o los registros.`,
          );
        }
      }

      const result = await res.json();
      if (version !== loadVersion) return;

      applicantsCache = result.data || [];
      loaded = true;
      loadingEl.classList.add("hidden");
      applySearch();
    } catch (err: any) {
      if (version !== loadVersion) return;
      loadingEl.classList.add("hidden");
      errorEl.classList.remove("hidden");
      document.getElementById("error-message")!.textContent =
        err.message || "Error al cargar los datos.";
    } finally {
      if (version === loadVersion) {
        listEl.setAttribute("aria-busy", "false");
        searchInput.disabled = !loaded;
        (document.getElementById("export-btn") as HTMLButtonElement).disabled = !loaded || displayedApplicants.length === 0;
      }
    }
  }

  // Videos are private: ask the server for a short-lived playback link when clicked.
  detailDialog.addEventListener("click", async (event) => {
    const button = (event.target as HTMLElement).closest<HTMLButtonElement>(".video-button");
    if (!button) return;
    button.disabled = true;
    try {
      const response = await fetch(`/api/recruitment/admin/applications/${button.dataset.id}/video`, { headers: { Authorization: `Bearer ${sessionToken}` } });
      const result = await response.json();
      if (!response.ok || !result.url) throw new Error(result.error || "No se pudo abrir el video.");
      if (!button.isConnected || !detailDialog.open) return;
      const url = new URL(result.url, window.location.origin);
      if (url.protocol !== "https:" && url.origin !== window.location.origin) throw new Error("Enlace de video inválido.");
      const container = detailDialog.querySelector<HTMLElement>(".inline-applicant-video")!;
      const frame = document.createElement("div");
      Object.assign(frame.style, { height: "360px", minHeight: "200px", maxHeight: "85vh", resize: "vertical", overflow: "auto", background: "#080808", marginTop: "12px", borderRadius: "12px" });
      const player = document.createElement(url.pathname.startsWith("/api/recruitment/video/") ? "iframe" : "video");
      player.src = url.href;
      Object.assign(player.style, { width: "100%", height: "100%", border: "0", objectFit: "contain", display: "block" });
      if (player instanceof HTMLIFrameElement) { player.title = "Video de postulación"; player.allowFullscreen = true; player.allow = "fullscreen"; player.referrerPolicy = "no-referrer"; }
      else { player.controls = true; player.preload = "metadata"; player.playsInline = true; }
      frame.append(player);
      const resize = document.createElement("button");
      resize.type = "button"; resize.textContent = "Ampliar reproductor"; resize.setAttribute("aria-pressed", "false");
      resize.className = "min-h-11 px-3 text-sm text-unicode cursor-pointer";
      resize.addEventListener("click", () => {
        const expanded = resize.getAttribute("aria-pressed") !== "true";
        resize.setAttribute("aria-pressed", String(expanded));
        resize.textContent = expanded ? "Reducir reproductor" : "Ampliar reproductor";
        frame.style.height = expanded ? "650px" : "360px";
      });
      const link = document.createElement("a");
      link.href = url.href; link.target = "_blank"; link.rel = "noopener noreferrer";
      link.textContent = "Abrir en otra pestaña"; link.className = "inline-flex items-center min-h-11 px-3 text-sm text-unicode";
      container.replaceChildren(resize, link, frame); container.hidden = false;
      container.style.width = "100%";
    } catch (error) {
      alert(error instanceof Error ? error.message : "No se pudo abrir el video.");
    } finally { button.disabled = false; }
  });

  function renderApplicants(applicants: Applicant[]) {
    document.getElementById("applicants-list")!.innerHTML = applicantListMarkup(applicants, currentArea);
  }
  document.getElementById("retry-btn")?.addEventListener("click", () => {
    loadApplicants();
  });

  // ===== EXPORT EXCEL (PRETTY) =====
  document.getElementById("export-btn")?.addEventListener("click", () => {
    if (displayedApplicants.length === 0) {
      alert("No hay datos para exportar.");
      return;
    }

    const headers = [
      "Nombres",
      "Apellidos",
      "Correo",
      "Teléfono",
      "Universidad",
      "Facultad",
      "Carrera",
      "Ingreso",
      "Ciclo",
      "Horas/semana",
      "Opción 1",
      "Opción 2",
      "Motivo",
      "Caso breve",
      "Algo que hizo",
      "Otras organizaciones",
      "Se enteró por",
      "Video",
      "Fecha de Registro",
    ];

    // CSS for Excel (Specific styles that Excel recognizes better)
    const style = `
      <style>
        .header-cell { background-color: #75d32d; color: black; font-weight: bold; border: 1.0pt solid black; text-align: center; vertical-align: middle; font-size: 12pt; }
        .data-cell { border: 0.5pt solid #cccccc; vertical-align: middle; padding: 5px; }
        td { vertical-align: middle; }
        .row-alt { background-color: #f2f2f2; }
        .opcion-1 { background-color: #dcfce7; vertical-align: middle; font-weight: bold; color: #166534; }
        .title { font-size: 18pt; font-weight: bold; color: #75d32d; }
      </style>
    `;

    const rowsHtml = displayedApplicants
      .map((p, index) => {
        const isFirst = p.first_choice_area === currentArea;
        const rowClass = index % 2 === 0 ? "" : 'class="row-alt"';
        return `
        <tr ${rowClass}>
          <td class="data-cell" style="vertical-align: middle;">${esc(p.first_name)}</td>
          <td class="data-cell" style="vertical-align: middle;">${esc(p.last_name)}</td>
          <td class="data-cell" style="vertical-align: middle;">${esc(p.email)}</td>
          <td class="data-cell" style="vnd.ms-excel.numberformat:@; vertical-align: middle;">${esc(p.phone)}</td>
          <td class="data-cell" style="vertical-align: middle;">${esc(p.university)}</td>
          <td class="data-cell" style="vertical-align: middle;">${esc(p.faculty)}</td>
          <td class="data-cell" style="vertical-align: middle;">${esc(p.career)}</td>
          <td class="data-cell" style="vnd.ms-excel.numberformat:@; text-align: center; vertical-align: middle;">${esc(p.admission_term)}</td>
          <td class="data-cell" style="text-align: center; vertical-align: middle;">${p.university_semester === 0 || p.university_semester === "0" ? "Egresado" : esc(p.university_semester)}</td>
          <td class="data-cell" style="text-align: center; vertical-align: middle;">${p.availability_hours ?? ""}</td>
          <td class="data-cell ${isFirst ? "opcion-1" : ""}" style="text-align: center; vertical-align: middle;">${esc(p.first_choice_area)}</td>
          <td class="data-cell" style="text-align: center; vertical-align: middle;">${esc(p.second_choice_area)}</td>
          <td class="data-cell" style="font-size: 9pt; width: 350px; vertical-align: middle;">${esc(p.application_reason).replace(/\n/g, "<br>")}</td>
          <td class="data-cell" style="font-size: 9pt; width: 350px; vertical-align: middle;">${esc(p.short_case).replace(/\n/g, "<br>")}</td>
          <td class="data-cell" style="font-size: 9pt; width: 350px; vertical-align: middle;">${esc(p.showcase).replace(/\n/g, "<br>")}</td>
          <td class="data-cell" style="font-size: 9pt; width: 350px; vertical-align: middle;">${esc(p.organizations).replace(/\n/g, "<br>")}</td>
          <td class="data-cell" style="vertical-align: middle;">${esc(p.referral_source)}</td>
          <td class="data-cell" style="vertical-align: middle;">${p.video_url ? `<a href="${esc(p.video_url)}">Ver video</a>` : ""}</td>
          <td class="data-cell" style="text-align: right; vertical-align: middle;">${new Date(p.created_at).toLocaleString("es-PE", { day: "2-digit", month: "2-digit", year: "numeric", hour: "2-digit", minute: "2-digit", hour12: true })}</td>
        </tr>
      `;
      })
      .join("");

    const htmlTemplate = `
      <html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:x="urn:schemas-microsoft-com:office:excel" xmlns="http://www.w3.org/TR/REC-html40">
      <head>
        <meta charset="utf-8">
        <!--[if gte mso 9]><xml><x:ExcelWorkbook><x:ExcelWorksheets><x:ExcelWorksheet>
         <x:Name>Postulantes ${currentArea}</x:Name>
         <x:WorksheetOptions><x:DisplayGridlines/></x:WorksheetOptions>
        </x:ExcelWorksheet></x:ExcelWorksheets></x:ExcelWorkbook></xml><![endif]-->
        ${style}
      </head>
      <body>
        <table>
          <tr><td colspan="${headers.length}" class="title">UNICODE - Reporte de Postulantes</td></tr>
          <tr><td colspan="${headers.length}" style="color: #666; font-size: 11pt;">Área: ${currentArea} | Fecha de reporte: ${new Date().toLocaleDateString("es-PE")}</td></tr>
          <tr><td></td></tr>
          <thead>
            <tr>${headers.map((h) => `<th class="header-cell">${h}</th>`).join("")}</tr>
          </thead>
          <tbody>
            ${rowsHtml}
          </tbody>
        </table>
      </body>
      </html>
    `;

    const blob = new Blob([htmlTemplate], { type: "application/vnd.ms-excel" });
    const link = document.createElement("a");
    link.href = URL.createObjectURL(blob);
    link.download = `applicants_${currentArea}_${new Date().toISOString().slice(0, 10)}.xls`;
    link.click();
    URL.revokeObjectURL(link.href);
  });
</script>
