import Navbar from "../components/navbar.astro";
import HeroCall from "../components/components-call/hero-call.astro";
import { publicConfig } from "../lib/recruitment/service";
const recruitment = await publicConfig();
Astro.response.headers.set("Cache-Control", "no-store");
---

<Layout title="Convocatoria">
  <Navbar />
  <HeroCall recruitment={recruitment} />
</Layout>
