---
/**
 * HeroCall.astro
 * Hero component for the recruitment page featuring background banner,
 * active status title, area list, and Call-To-Action buttons.
 *
 * @component
 */
interface Props { recruitment: { available: boolean; reason?: string | null; deploymentReady?: boolean; config: { title: string; enabled: boolean; opensAt: string | null; areas: { id: string; enabled: boolean }[] } } }
const { recruitment } = Astro.props;
const IS_CALL_OPEN = recruitment.available;
// Enabled in the admin panel with a future opening date: count down instead of "Próximamente".
const opensAt = recruitment.config.opensAt ? Date.parse(recruitment.config.opensAt) : NaN;
const IS_UPCOMING = !IS_CALL_OPEN && recruitment.config.enabled && recruitment.deploymentReady !== false && opensAt > Date.now();
const SHOW_AREAS = IS_CALL_OPEN || IS_UPCOMING;
const opensTime = IS_UPCOMING ? new Intl.DateTimeFormat("es-PE", { timeZone: "America/Lima", hour: "numeric", minute: "2-digit" }).format(opensAt) : "";

interface Area {
  icon: string;
  label: string;
}

const areas: Area[] = [
  { icon: "gth", label: "GTH" },
  { icon: "acd", label: "ACD" },
  { icon: "rrpp", label: "RRPP" },
  { icon: "dcc", label: "DCC" },
  { icon: "id", label: "ID" },
  { icon: "lge", label: "LGE" },
].filter((area) => !SHOW_AREAS || recruitment.config.areas.some((configured) => configured.id === area.label.toUpperCase() && configured.enabled));
---

<section
  class="relative w-full min-h-[100svh] flex items-center justify-center overflow-hidden pt-24 pb-10"
>
  <div class="absolute inset-0 z-0">
    <img
      src="/convocatoria-hero.webp"
      alt="Evento UNICODE"
      class="w-full h-full object-cover"
      loading="eager"
    />
    <div
      class="absolute inset-0 bg-linear-to-b from-black/70 via-black/60 to-[#050505]"
    >
    </div>
  </div>

  <div class="relative z-10 w-full max-w-3xl mx-auto px-6 text-center flex flex-col items-center">
    <p
      class="text-white text-xl sm:text-2xl md:text-3xl lg:text-4xl font-bold tracking-[0.25em] uppercase mb-2"
    >
      CONVOCATORIA
    </p>

    {SHOW_AREAS ? (
      <h1
        class="text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold text-unicode text-glow tracking-tight leading-none mb-4"
      >
        UNICODE
      </h1>
    ) : (
      <h1
        class="text-4xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold text-zinc-300 tracking-tight leading-none mb-4 uppercase"
      >
        PRÓXIMAMENTE
      </h1>
    )}
    
    <p class="text-zinc-400 text-xs md:text-sm font-semibold tracking-widest uppercase mb-6 md:mb-8">
      {SHOW_AREAS ? recruitment.config.title : "Proceso de Selección UNICODE"}
    </p>

    {IS_CALL_OPEN ? (
      <p
        class="text-zinc-300 text-sm md:text-base max-w-xl mx-auto mb-12 leading-relaxed"
      >
        Encuentra el área donde puedes aportar a UNICODE. Completa tus datos y responde
        cuatro preguntas en un video de hasta 2 minutos y medio.
      </p>
    ) : IS_UPCOMING ? (
      <div id="call-countdown" data-opens-at={new Date(opensAt).toISOString()} class="mb-8 w-full">
        <div class="grid grid-cols-4 gap-2 sm:gap-4 max-w-md mx-auto" role="timer" aria-live="off" aria-label="Tiempo para la apertura">
          {[["days", "Días"], ["hours", "Horas"], ["minutes", "Min"], ["seconds", "Seg"]].map(([unit, label]) => (
            <div class="rounded-2xl border border-unicode/40 bg-unicode/10 px-1 py-3 sm:py-4 backdrop-blur-sm">
              <span data-unit={unit} class="block text-3xl sm:text-5xl font-extrabold text-unicode text-glow tabular-nums leading-none">--</span>
              <span class="mt-2 block text-[0.65rem] sm:text-xs font-semibold uppercase tracking-widest text-zinc-400">{label}</span>
            </div>
          ))}
        </div>
      </div>
    ) : (
      <p
        class="text-zinc-400 text-sm md:text-base max-w-xl mx-auto mb-12 leading-relaxed"
      >
        La convocatoria se encuentra cerrada por el momento. ¡Gracias por tu interés! Mantente al tanto de nuestras redes sociales para enterarte de la apertura de nuestro próximo proceso de selección.
      </p>
    )}

    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-5 sm:gap-10 mb-8 max-w-xs sm:max-w-none mx-auto">
      {
        areas.map((area) => (
          <div
            class={`flex flex-col items-center gap-2 ${SHOW_AREAS ? "" : "opacity-30 cursor-not-allowed"}`}
          >
            <div
              class={`w-12 h-12 md:w-14 md:h-14 rounded-xl flex items-center justify-center backdrop-blur-sm transition-all duration-300 border ${
                SHOW_AREAS
                  ? "border-white/10 bg-white/5 text-zinc-400 hover:border-unicode/40 hover:text-unicode"
                  : "border-white/5 bg-white/5 text-zinc-500"
              }`}
            >
              {area.icon === "gth" && (
                <svg
                  class="w-6 h-6 md:w-7 md:h-7"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.964-3.07M12 6.375a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zm8.25 2.25a2.625 2.625 0 11-5.25 0 2.625 2.625 0 015.25 0z"
                  />
                </svg>
              )}
              {area.icon === "acd" && (
                <svg
                  class="w-6 h-6 md:w-7 md:h-7"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M4.26 10.147a60.438 60.438 0 00-.491 6.347A48.62 48.62 0 0112 20.904a48.62 48.62 0 018.232-4.41 60.46 60.46 0 00-.491-6.347m-15.482 0a50.636 50.636 0 00-2.658-.813A59.906 59.906 0 0112 3.493a59.903 59.903 0 0110.399 5.84c-.896.248-1.783.52-2.658.814m-15.482 0A50.717 50.717 0 0112 13.489a50.702 50.702 0 017.74-3.342"
                  />
                </svg>
              )}
              {area.icon === "rrpp" && (
                <svg
                  class="w-6 h-6 md:w-7 md:h-7"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M10.34 15.84c-.688-.06-1.386-.09-2.09-.09H7.5a4.5 4.5 0 110-9h.75c.704 0 1.402-.03 2.09-.09m0 9.18c.253.962.584 1.892.985 2.783.247.55.06 1.21-.463 1.511l-.657.38c-.551.318-1.26.117-1.527-.461a20.845 20.845 0 01-1.44-4.282m3.102.069a18.03 18.03 0 01-.59-4.59c0-1.586.205-3.124.59-4.59m0 9.18a23.848 23.848 0 018.835 2.535M10.34 6.66a23.847 23.847 0 008.835-2.535m0 0A23.74 23.74 0 0018.795 3m.38 1.125a23.91 23.91 0 011.014 5.395m-1.014 8.855c-.118.38-.245.754-.38 1.125m.38-1.125a23.91 23.91 0 001.014-5.395m0-3.46c.495.413.811 1.035.811 1.73 0 .695-.316 1.317-.811 1.73m0-3.46a24.347 24.347 0 010 3.46"
                  />
                </svg>
              )}
              {area.icon === "dcc" && (
                <svg
                  class="w-6 h-6 md:w-7 md:h-7"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"
                  />
                </svg>
              )}
              {area.icon === "id" && (
                <svg
                  class="w-6 h-6 md:w-7 md:h-7"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    d="M17.25 6.75 22.5 12l-5.25 5.25 M6.75 17.25 1.5 12l5.25-5.25 M14.25 4.5l-4.5 15"
                  />
                </svg>
              )}
              {area.icon === "lge" && <span class="font-bold text-sm">LGE</span>}
            </div>
            <span
              class={`font-bold text-xs md:text-sm tracking-wider ${
                IS_CALL_OPEN ? "text-zinc-400" : "text-zinc-600"
              }`}
            >
              {area.label}
            </span>
          </div>
        ))
      }
    </div>

    {IS_CALL_OPEN ? (
      <a
        href="/postular"
        class="inline-block px-10 py-3.5 bg-unicode hover:bg-unicode-light text-black font-bold rounded-full transition-all duration-300 text-base shadow-unicode hover:shadow-unicode-lg transform hover:-translate-y-1"
      >
        Postula a UNICODE
      </a>
    ) : IS_UPCOMING ? (
      <span
        id="countdown-cta"
        class="inline-block px-10 py-3.5 rounded-full text-base font-bold border border-unicode/60 text-unicode bg-unicode/10 cursor-not-allowed"
      >
        Abre a las {opensTime}
      </span>
    ) : (
      <span
        class="inline-block px-10 py-3.5 bg-zinc-900 text-zinc-400 font-bold rounded-full text-base cursor-not-allowed border border-zinc-800"
      >
        Próximamente
      </span>
    )}
  </div>
</section>

<script>
  const countdown = document.getElementById("call-countdown");
  if (countdown) {
    const opensAt = Date.parse(countdown.dataset.opensAt || "");
    const pad = (value: number) => String(value).padStart(2, "0");
    const tick = () => {
      const left = Math.max(0, opensAt - Date.now());
      const total = Math.floor(left / 1000);
      const values = { days: Math.floor(total / 86400), hours: Math.floor(total / 3600) % 24, minutes: Math.floor(total / 60) % 60, seconds: total % 60 };
      for (const [unit, value] of Object.entries(values)) {
        const cell = countdown.querySelector(`[data-unit="${unit}"]`);
        if (cell) cell.textContent = pad(value);
      }
      if (left > 0) return;
      clearInterval(timer);
      const cta = document.getElementById("countdown-cta");
      if (cta) cta.textContent = "¡Abrimos! Cargando…";
      // A short delay absorbs small clock differences with the server.
      setTimeout(() => location.reload(), 1500);
    };
    const timer = setInterval(tick, 1000);
    tick();
  }
</script>
