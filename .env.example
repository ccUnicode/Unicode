# Admin panel password for /admin
ADMIN_PASSWORD=your_admin_password

# Supabase REST API URL (e.g., https://your-project.supabase.co)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase public anonymous key (exposed to the browser)
PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service role key (CRITICAL: admin access, server-side only)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Recruitment A/B/F: all credentials below are server-only.
# Use a stable, random encryption key independently of either Supabase project.
RECRUITMENT_RESUME_ENCRYPTION_KEY=
RECRUITMENT_BASE_URL=https://your-production-domain.example

# Private Drive uploads. OAuth must be authorized by the account that owns the folder.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
DRIVE_VIDEO_FOLDER_ID=

# Alternative private Supabase Storage bucket, if selected in GTH settings.
RECRUITMENT_VIDEO_BUCKET=recruitment-videos

# Durable email transport; verify the sender with the provider before activation.
RECRUITMENT_EMAIL_PROVIDER=resend
RESEND_API_KEY=
RECRUITMENT_EMAIL_FROM=
CRON_SECRET=

# Optional real local PostgreSQL engine for development only (never production).
# RECRUITMENT_LOCAL_DB_PATH=.recruitment-local/db
